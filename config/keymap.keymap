#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp W             &kp E                   &kp LEFT_PARENTHESIS  &kp I  &kp RIGHT_PARENTHESIS                                                            &kp F  &kp S  &kp Y                &kp H                  &kp P
&kp A             &kp U                   &kp X                 &kp C  &kp O                                                                            &kp R  &kp K  &kp T                &kp D                  &kp N
&kp Q             &mt AMPERSAND QUESTION  &kp J                 &kp V  &lt 4 COMMA            &mt LEFT_SHIFT PERIOD                      &kp BACKSPACE  &kp Z  &kp G  &kp B                &kp L                  &kp M
&lt 6 LANGUAGE_2  &kp LG(Z)               &kp LS(LG(Z))                                       &kp SPACE              &mkp MB1  &mkp MB1  &lt 3 ENTER                  &mt RIGHT_ALT MINUS  &mt RIGHT_CONTROL TAB  &mt RIGHT_COMMAND LANGUAGE_1
            >;
        };

        layer_1 {
            bindings = <
&none  &none  &none  &none  &none                              &none  &none  &none  &none  &none
&none  &none  &none  &none  &none                              &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
&none  &none  &none                &none  &none  &none  &none                &none  &none  &none
            >;
        };

        mouse-1 {
            bindings = <
&kp ESCAPE            &mt END HOME          &kp GLOBE      &kp C  &kp LG(LC(A))                                      &mt RG(RA(DOWN)) RA(RG(UP))  &mkp MB4      &mkp MB5       &mkp MB1        &mkp MB2
&kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_1))  &kp LS(LG(X))  &none  &kp LG(LEFT)                                       &kp RS(RC(TAB))              &kp RC(TAB)   &mkp MB3       &msc SCRL_LEFT  &msc SCRL_RIGHT
&kp LS(LG(V))         &kp LS(LG(NUMBER_4))  &kp LS(LG(F))  &none  &trans         &trans                      &trans  &none                        &kp RC(LEFT)  &kp RC(RIGHT)  &msc SCRL_DOWN  &msc SCRL_UP
&trans                &trans                &trans                               &mkp MB2  &mkp MB1  &trans  &trans                                             &trans         &trans          &trans
            >;
        };

        mouse-2 {
            bindings = <
&kp ESC         &mt END HOME    &kp GLOBE      &kp C   &kp LG(LC(A))                                      &trans  &trans  &trans  &trans  &trans
&kp LS(LG(N2))  &kp LS(LG(N1))  &kp LS(LG(X))  &trans  &kp LC(LEFT)                                       &trans  &trans  &trans  &trans  &trans
&kp LS(LG(V))   &kp LS(LG(N4))  &kp LS(LG(F))  &trans  &trans         &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans          &trans                                &mkp MB2  &mkp MB1  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        number {
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N9)    &kp LS(N5)       &kp LS(N0)                                  &kp N7  &kp N8  &kp N9  &kp KP_EQUAL  &kp INT_YEN
&kp LS(N3)  &kp LS(N4)  &kp KP_SLASH  &kp KP_MULTIPLY  &kp LS(N6)                                  &kp N4  &kp N5  &kp N6  &kp COLON     &kp TILDE
&kp LS(N7)  &kp LS(N8)  &kp KP_PLUS   &kp KP_MINUS     &trans      &trans                  &trans  &kp N1  &kp N2  &kp N3  &kp N0        &kp PERIOD
&trans      &trans      &kp LG(Y)                                  &trans  &trans  &trans  &trans                  &trans  &trans        &trans
            >;
        };

        symbol {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                  &trans  &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                  &trans  &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
